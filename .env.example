# Platybill configuration — copy to .env (`cp .env.example .env`) and adjust.
# Every value has a working default; the reverse-proxy and notification
# settings are the ones worth changing in a typical deployment. Never commit .env.

# --- Image / release ---
# Prod compose only (docker-compose.prod.yml): the image tag to run.
# `latest` follows the rolling green-main builds; pin a `sha-<7>` tag from
# the registry for reproducible updates.
PLATYBILL_TAG=latest
# Version shown in the app footer. Baked in at build time: CI passes sha-<7>,
# local builds default to "dev". Override it to label a custom build.
NEXT_PUBLIC_APP_VERSION=dev
# Seconds between proactive session-expiry checks on an idle authenticated tab.
NEXT_PUBLIC_SESSION_HEARTBEAT_SECONDS=180

# --- Runtime ---
# development | production. Set production for public deployments: it disables
# API docs and turns the default-secret warning into a startup failure.
ENVIRONMENT=development
# Set true ONLY when serving over HTTPS (reverse proxy). Over plain HTTP
# browsers reject Secure cookies and login appears to succeed then bounces
# back to /login.
COOKIE_SECURE=false
# Set true ONLY behind a reverse proxy you control (Caddy, nginx, SWAG,
# Cloudflare) that appends the real client IP to X-Forwarded-For — rate
# limiting then keys on that address. When the container port is exposed
# directly, leave false: the built-in Next proxy forwards a client-supplied
# X-Forwarded-For unchanged, so trusting it would let clients spoof their IP
# and bypass rate limits.
TRUST_PROXY=false
# --- Bill import (optional) ---
# Extract bills locally through Ollama (no cloud calls). Uploads work as soon
# as OLLAMA_BASE_URL is set; the folder/email pollers additionally need
# IMPORT_ENABLED=true. Every import is reviewed before it is applied.
# OLLAMA_BASE_URL=http://10.112.200.20:11434
# OLLAMA_MODEL=gemma4   # or numind/nuextract3:q4_k_m (fast, reads currency)
# OLLAMA_OCR_MODEL=maternion/LightOnOCR-2:1b
# OLLAMA_TEXT_MODEL=gemma4
# IMPORT_ENABLED=false
# IMPORT_USER_EMAIL=you@example.com
# IMPORT_DIR=/data/import
# IMPORT_POLL_MINUTES=15
# IMPORT_KEEP_FILES=false
# IMAP_HOST=imap.example.com
# IMAP_USER=bills@example.com
# IMAP_PASSWORD=
# IMAP_FOLDER=INBOX

# Time zone for the reminder scheduler and log timestamps (TZ database name),
# e.g. Europe/Warsaw. tzdata is installed in the image.
TZ=Etc/UTC

# --- Auth ---
# Leave empty to auto-generate a strong secret on first start and persist it
# at /data/jwt_secret. Set it explicitly to keep a stable secret across
# reinstalls/migrations (users still sign in once — see README § Migrating).
JWT_SECRET=
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---
# SQLite lives at /data/platybill.db (WAL mode, foreign keys on). Override
# only for an exotic setup — the file must stay on the mounted /data volume.
# DATABASE_URL=sqlite:////data/platybill.db

# --- Unraid / root starts ---
# When the container starts as root, these set the owner used for /data and
# the supervised processes. The Community Applications template uses 99/100.
# Ignored by docker compose, which runs as user 10001:10001.
# PUID=99
# PGID=100

# Rate limiting (in-memory, per-process)
# login: 10/min | register: 25/hour | forgot-password: 5/hour
# reset-password: 5/10min | change-password: 5/hour
# change-email: 5/hour | send-now: 2/hour

# --- Notifications ---
# Apprise (recommended primary channel). Run an Apprise API gateway and point
# APPRISE_BASE_URL at it; email (SMTP) below is an optional legacy fallback.
# Gateway images: caronc/apprise or lscr.io/linuxserver/apprise-api.
# (unraid/apprise-go is a CLI-only port with no HTTP server — it needs a wrapper.)
# Reachability: the app container must be able to reach the gateway —
# use the host IP or a shared Docker network ("localhost" would point at the
# app container itself).
# Minimum setup (targets configured inside the gateway, e.g. its own
# APPRISE_STATELESS_URLS or a saved config key):
# APPRISE_BASE_URL=http://apprise:8000   (gateway on the same Docker network)
# or http://<your-host-ip>:8000          (gateway outside the compose network)
# Optional stateful key (saved configuration inside the gateway):
# APPRISE_KEY=platybill
# Optional stateless targets passed per request (space/comma separated);
# APPRISE_KEY wins over APPRISE_URLS when both are set:
# APPRISE_URLS="ntfy://topic discord://webhook_id/webhook_token"
# APPRISE_TIMEOUT_SECONDS=10

# --- Reminders (optional legacy fallback) ---
# SMTP is only used when Apprise is not configured or fails. Password reset
# still requires SMTP; without it the "Forgot password" link is hidden.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASSWORD=changeme
# SMTP_USE_TLS=true
# REMINDER_FROM=noreply@yourdomain.com
# Domains whose users are silently skipped by the notification scheduler (JSON array).
# Default already blocks test.com and example.com.
# EMAIL_BLOCKED_DOMAINS=["test.com","example.com"]

# --- Password reset ---
# Public URL of the app, used in password-reset links.
APP_BASE_URL=http://localhost:3010
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# --- Backups / restore safety ---
# Pre-migration snapshots taken automatically before `alembic upgrade head`
# runs on container start, kept in /data/backups (default 10).
# BACKUP_KEEP=10
# Days a pre-restore snapshot stays recoverable before the cleanup job
# deletes it (in-app JSON restore safety net).
RESTORE_SNAPSHOT_RETENTION_DAYS=7
# Host-side infra/backup.sh retention, in days.
# BACKUP_KEEP_DAYS=30
